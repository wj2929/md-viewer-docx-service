FROM node:20-slim AS chart-assets

WORKDIR /assets
COPY package*.json ./
RUN npm ci --omit=dev

FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      fonts-noto-cjk \
      graphviz \
      fontconfig \
      curl \
      ca-certificates \
      libnss3 \
      libnspr4 \
      libatk1.0-0 \
      libatk-bridge2.0-0 \
      libcups2 \
      libdrm2 \
      libxkbcommon0 \
      libxcomposite1 \
      libxdamage1 \
      libxfixes3 \
      libxrandr2 \
      libgbm1 \
      libasound2 \
    && rm -rf /var/lib/apt/lists/*

COPY fonts/ /usr/share/fonts/truetype/custom/
RUN fc-cache -fv

WORKDIR /app
COPY requirements.txt requirements-full.txt ./
RUN pip install --no-cache-dir -r requirements-full.txt \
    && python -m playwright install chromium

COPY app/ ./app/
COPY renderers/ ./renderers/
COPY --from=chart-assets /usr/local/bin/node /usr/local/bin/node
COPY --from=chart-assets /assets/node_modules ./node_modules

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD curl -f http://localhost:3000/healthz || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "3000", "--workers", "2"]
