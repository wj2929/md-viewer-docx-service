# Optional API key for non-local deployments.
# Leave empty only for localhost-only development.
API_KEY=

# Rate limit per source IP.
RATE_LIMIT_PER_MIN=30

# Optional additional font lookup paths.
# Use colon-separated values on macOS/Linux.
MD_VIEWER_DOCX_FONT_PATHS=
MD_VIEWER_DOCX_FONT_DIRS=

# /convert-source URL input policy: local-friendly, strict, or allowlist.
# local-friendly is intended for trusted local/internal automation.
MDV_SOURCE_URL_POLICY=local-friendly
MDV_SOURCE_URL_ALLOWLIST=

# Full fidelity renderer runtime.
MDV_RENDER_ARTIFACT_DIR=/app/renderers/dist/server-render
MDV_RENDER_CLI=/app/renderers/mdv-renderer-cli.mjs
MDV_RENDER_TIMEOUT_MS=60000
MDV_RENDER_CLI_GRACE_MS=60000
MDV_RENDER_NETWORK_POLICY=local-friendly
MDV_RENDER_ALLOWLIST_HOSTS=
MDV_RENDER_CONCURRENCY=1

# PlantUML rendering.
MDV_PLANTUML_SERVER_URL=https://www.plantuml.com/plantuml
MDV_PLANTUML_TIMEOUT_SEC=12
MDV_PLANTUML_RETRIES=3
